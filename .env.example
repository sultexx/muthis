# Mut'his — environment template.
#
# Copy to `.env` in the repository root, then fill in the values.
# `.env` is git-ignored and MUST NEVER be committed (AGENTS.md, "Do NOT").
# This file carries NAMES and EXPLANATIONS ONLY — never a value, not even a
# truncated one.
#
# Loading order is a LAW: `.env` is read once at process entry, BEFORE any SDK
# import (`main.py`). Adding a variable here does not wire it — the reader lives
# in the module that needs it.
#
# Every name below is read by `src/`. Names that look like knobs but are module
# constants (TAVILY_SEARCH_PATH, BRAVE_COST_PER_QUERY_USD, ELEVENLABS_WS_BASE,
# GEMINI_SAMPLE_RATE, MUTHIS_DOC_INGEST_BUDGET_S, MUTHIS_DOC_INJECT_LIMIT, and
# the *_DEFAULT_BASE_URL pair) are deliberately ABSENT: they cannot be set here.

# ==============================================================================
# 1. REQUIRED — the three credentials Mut'his cannot start a real turn without
# ==============================================================================

# Reasoning + vision (Claude Sonnet, `anthropic` SDK, SSE streaming).
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Speech-to-text (ElevenLabs Scribe, language pinned "ar") and the PRIMARY TTS
# voice. Get one at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Fallback TTS voice (used when ElevenLabs is unavailable or unkeyed).
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ==============================================================================
# 2. LEARNED THE HARD WAY — two variables whose ABSENCE fails silently
# ==============================================================================

# THE ARABIC ACCENT. Paste a NATIVE Arabic voice id (a Saudi/Gulf male voice
# reads best). The built-in default is a PLACEHOLDER that does not resolve, and
# an unresolvable id does not crash — it hard-fails to the Gemini fallback, so
# every turn silently degrades to the wrong voice and nothing in the log says
# why. If Mut'his sounds wrong, check this FIRST.
# Find ids at: https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=

# THE SOVEREIGN DAILY SPEND CEILING, in USD (Rule 10). Default 0.75.
# This was absent from `.env` for weeks, and the consequence was not an error —
# it was that the ceiling could not be RAISED: the app kept enforcing its
# built-in default while the operator believed a higher limit was in force.
# An absent budget variable looks exactly like a working one until a turn is
# refused. Set it explicitly, even to the default.
MUTHIS_DAILY_BUDGET_USD=

# ==============================================================================
# 3. WEB RESEARCH — search providers (selection is CONFIGURATION, never a tool
#    argument; a tainted model can never aim the key-bearing client)
# ==============================================================================

# Which vendor answers: tavily | brave | searxng.
# Unset = auto-detect in order: Tavily, then Brave, then SearXNG.
# Nothing configured is NOT an error: the tool stays in the catalogue and
# returns a short Arabic "add a key in .env" note.
MUTHIS_SEARCH_PROVIDER=

# DEFAULT provider. Tavily returns EXTRACTED CONTENT rather than only links,
# which collapses the search->fetch cycle: fewer fetches = a narrower SSRF
# surface, lower cost, lower latency.
# Get one at: https://app.tavily.com/home
TAVILY_API_KEY=
# Optional endpoint override (default https://api.tavily.com).
TAVILY_BASE_URL=

# Keyed alternative. Brave returns links + snippets, so a follow-up fetch is
# needed more often than with Tavily — SWITCHING PROVIDER IS A TRUST-SURFACE
# CHANGE, not a preference.
# Get one at: https://api-dashboard.search.brave.com/app/keys
BRAVE_API_KEY=
BRAVE_BASE_URL=

# MAXIMUM-PRIVACY option: SearXNG is self-hosted — no key, no credential of any
# kind on the request, zero cost, and the query never reaches a commercial
# vendor. It has NO default on purpose: an unset base URL means the machine
# owner has not made the trust decision, and Mut'his never invents an instance.
# Pointing this at localhost or a private LAN address is NORMAL and legitimate
# here — precisely the destination the hardened fetcher blocks by design —
# because THIS address comes from the owner's own `.env`, while the fetcher's
# URL comes from the model reading tainted web content.
# Self-host: https://docs.searxng.org/
SEARXNG_BASE_URL=

# ==============================================================================
# 4. MODEL / PROVIDER TUNING (optional)
# ==============================================================================

# Override the pinned Claude model string. THERE IS NO FALLBACK TABLE — if the
# pinned model 404s the behaviour is UNDEFINED; choosing a replacement is a cost
# and vision decision, not a config tweak.
MUTHIS_CLAUDE_MODEL=
# Max output tokens per provider turn.
MUTHIS_CLAUDE_MAX_TOKENS=
# Route Anthropic traffic through a proxy (the planned production key home is a
# Cloudflare Worker, so the key never sits on the client).
MUTHIS_ANTHROPIC_BASE_URL=
# Longest edge of the screenshot sent to the model, in pixels.
MUTHIS_VISION_MAX_WIDTH=
# Directory holding the pinned local document-embedding model. The artifact is
# verified BY FINGERPRINT, never trusted by name.
MUTHIS_DOC_MODEL_DIR=

# ==============================================================================
# 5. VOICE (optional)
# ==============================================================================

# ElevenLabs is PRIMARY TTS, default ON. Set falsey to force Gemini.
MUTHIS_TRY_ELEVENLABS=
# TTS model (default eleven_flash_v2_5).
ELEVENLABS_MODEL_ID=
# STT model for Scribe.
ELEVENLABS_STT_MODEL_ID=
# voice_settings floats. Defaults 0.7 / 0.8 / 0.0 — HIGHER STABILITY LOCKS THE
# ARABIC ACCENT, which is why the default is not the vendor's.
ELEVENLABS_STABILITY=
ELEVENLABS_SIMILARITY_BOOST=
ELEVENLABS_STYLE=
# Gemini fallback voice (default "Kore", male; e.g. Fenrir).
MUTHIS_GEMINI_VOICE=
GEMINI_TTS_VOICE=
GEMINI_TTS_MODEL=
# Gemini TTS request timeout in seconds (default 30; one fast retry on timeout).
MUTHIS_GEMINI_TIMEOUT_S=

# ==============================================================================
# 6. FEATURE FLAGS — every one is a single-variable rollback switch
# ==============================================================================

# ONE continuous ElevenLabs generation per turn. DEFAULT OFF — unset keeps the
# proven buffer-then-speak path.
MUTHIS_STREAM_TTS=
# Live-captions bar (default ON). Falsey rolls back to the caption-less UI.
MUTHIS_CAPTIONS=
# F9 press while speaking interrupts the teacher (default ON).
# F9 IS BARGE-IN AND NOTHING ELSE — it never means "exit".
MUTHIS_BARGE_IN=
# Dim the screen behind a concept drawing (default ON).
MUTHIS_WHITEBOARD=
# Cinematic spotlight: dim everything except the highlight (default OFF).
MUTHIS_FOCUS_DIM=
# Dim opacity 0..1 for spotlight and whiteboard (default 0.30, clamped).
MUTHIS_FOCUS_ALPHA=
# UI lifecycle sounds (default on; Windows-only).
MUTHIS_EARCONS=

# ==============================================================================
# 7. INPUT (optional)
# ==============================================================================

# Push-to-talk key (default "f9"). HOLD while speaking, release to send.
MUTHIS_HOTKEY=
# Minimum hold before a tap counts as empty (default 0.35 s).
MUTHIS_MIN_RECORD_SECONDS=
# Fixed recording window — DEV SMOKE SCRIPTS ONLY, not the live app.
MUTHIS_RECORD_SECONDS=

# ==============================================================================
# 8. OVERLAY APPEARANCE (optional) — neon #RRGGBB, never the #FF00FF chroma key
# ==============================================================================

MUTHIS_COLOR_LINE=
MUTHIS_COLOR_ARROW=
MUTHIS_COLOR_CIRCLE=
MUTHIS_COLOR_RECT=
MUTHIS_COLOR_POINTER=
MUTHIS_COLOR_HIGHLIGHT=
# Pointer glide duration in ms (default 500).
MUTHIS_POINTER_ANIM_MS=
# Glow halo (default on) / halo px (default 4) / intensity 0..1 (default 0.35).
MUTHIS_GLOW=
MUTHIS_GLOW_WIDTH=
MUTHIS_GLOW_INTENSITY=
# Core stroke px (default 3).
MUTHIS_CORE_WIDTH=
# Caption chip font / size (default 16) / plate colour (default #0B0F1A).
MUTHIS_LABEL_FONT=
MUTHIS_LABEL_SIZE=
MUTHIS_LABEL_PLATE=
# Status-light colours (defaults cyan / amber / green; idle is hidden) and
# corner: top-left | top-right | bottom-left | bottom-right (default bottom-right).
MUTHIS_STATUS_LISTENING=
MUTHIS_STATUS_THINKING=
MUTHIS_STATUS_SPEAKING=
MUTHIS_STATUS_CORNER=

# ==============================================================================
# 9. DEBUG
# ==============================================================================

# The ONLY gate for transcript logging. MUST NEVER default to on.
# Privacy rule: no transcripts, audio, or screenshots are logged by default.
MUTHIS_DEBUG=

# ==============================================================================
# 10. MEASUREMENT ONLY — NOT read by `src/`
# ==============================================================================
#
# The one exception to this file's "every name below is read by src/" rule, and
# it is stated rather than quietly filed among the real ones.
#
# Read at exactly ONE site, `scripts/probe_provider.py`, which imports nothing
# from the reasoning path and is imported by nothing in it. No module under
# `src/` reads this name — grep it and the only hit is the probe. That is the
# TAVILY_API_KEY discipline applied to a credential that has no plugin, no
# capability and no route: a key with one reader cannot leak through a seam it
# was never handed to.
#
# It exists because a SECOND reasoning provider has never been driven through
# this project's real catalogue, real stream contract, real persona and real
# pointing path, and nobody knows whether the CloudReasoner protocol survives
# one. Leave it EMPTY unless a probe is being run.
OPENAI_API_KEY=
